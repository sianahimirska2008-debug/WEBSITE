// Gettable data model.
// SQLite for local dev. To switch to Postgres, change `provider` to "postgresql"
// and point DATABASE_URL at your Postgres instance, then run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  BUSINESS
}

enum BusinessType {
  SALON
  BEAUTY
  BARBER
}

enum SlotStatus {
  OPEN
  /// Temporarily reserved while a customer completes payment (see Slot.heldUntil)
  HELD
  BOOKED
  CANCELLED
}

enum BookingStatus {
  /// Checkout started; slot is HELD until payment succeeds or the session expires
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  /// Checkout was abandoned or expired before payment
  EXPIRED
}

/// Money owed to the business (85%) for a booking.
enum PayoutStatus {
  /// Not due yet (booking not completed / no-show)
  NOT_DUE
  /// Due, but the business hasn't finished Stripe onboarding (or a dispute is open)
  ON_HOLD
  /// Transfer is being created
  PROCESSING
  /// Transfer created to the connected account
  PAID
  /// Transfer attempt failed; retried by the payouts job
  FAILED
  /// Transfer was reversed (refund after completion)
  REVERSED
  /// Nothing will be paid (booking cancelled and refunded)
  NONE
}

enum RefundStatus {
  NONE
  PENDING
  SUCCEEDED
  FAILED
}

enum CancelledBy {
  CUSTOMER
  BUSINESS
  PLATFORM
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(CUSTOMER)
  createdAt    DateTime    @default(now())
  businesses   Business[]
  bookings     Booking[]
  favourites   Favourite[]
}

model Business {
  id                    String       @id @default(cuid())
  ownerId               String
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                  String
  slug                  String       @unique
  type                  BusinessType
  description           String       @default("")
  address               String
  postcode              String       @default("")
  area                  String       @default("")
  lat                   Float
  lng                   Float
  logoUrl               String?
  phone                 String?
  /// JSON: { mon: "09:00-18:00", ..., sun: "closed" }
  openingHours          String       @default("{}")
  /// Denormalised rating for listing pages; recalculated when reviews are added.
  ratingAvg             Float        @default(0)
  ratingCount           Int          @default(0)
  /// Stripe connected account (Accounts v2, recipient configuration)
  stripeAccountId       String?      @unique
  /// True once the stripe_transfers capability is active, i.e. we can pay this business
  payoutsEnabled        Boolean      @default(false)
  stripeStatusCheckedAt DateTime?
  createdAt             DateTime     @default(now())
  treatments            Treatment[]
  slots                 Slot[]
  favourites            Favourite[]

  @@index([ownerId])
}

model Treatment {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  /// One of the CATEGORIES in src/lib/categories.ts
  category      String
  durationMins  Int
  /// Pence
  standardPrice Int
  slots         Slot[]

  @@index([businessId])
  @@index([category])
}

model Slot {
  id            String     @id @default(cuid())
  businessId    String
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  treatmentId   String
  treatment     Treatment  @relation(fields: [treatmentId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  durationMins  Int
  /// Pence
  originalPrice Int
  /// Pence (discounted)
  price         Int
  stylistName   String?
  status        SlotStatus @default(OPEN)
  /// When status is HELD: the hold lapses at this time
  heldUntil     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  bookings      Booking[]

  @@index([status, startsAt])
  @@index([businessId, startsAt])
}

model Booking {
  id                String        @id @default(cuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId            String
  slot              Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// Pence charged to the customer
  totalPaid         Int
  status            BookingStatus @default(CONFIRMED)
  reference         String        @unique
  /// Provider payment id (Stripe PaymentIntent id, or mock id)
  paymentRef        String?
  /// Stripe Checkout Session id
  checkoutSessionId String?       @unique
  /// Stripe Charge id; transfers are tied to it with source_transaction
  chargeId          String?
  /// GETTABLE's commission in pence, fixed when payment is confirmed
  commission        Int           @default(0)
  /// Business share in pence (totalPaid - commission)
  businessAmount    Int           @default(0)
  payoutStatus      PayoutStatus  @default(NOT_DUE)
  transferId        String?
  payoutError       String?
  paidOutAt         DateTime?
  refundStatus      RefundStatus  @default(NONE)
  refundedAmount    Int           @default(0)
  refundId          String?
  disputeStatus     String?
  cancelledBy       CancelledBy?
  cancelledAt       DateTime?
  completedAt       DateTime?
  autoCompleted     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  review            Review?

  @@index([userId])
  @@index([slotId])
  @@index([status, payoutStatus])
}

/// Stripe webhook events already handled (idempotency).
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model Favourite {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, businessId])
}

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
}
