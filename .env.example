# --- Database ---------------------------------------------------------------
# SQLite for local dev. For Postgres: change provider in prisma/schema.prisma and set e.g.
# DATABASE_URL="postgresql://user:pass@localhost:5432/gettable"
DATABASE_URL="file:./dev.db"

# --- Auth -------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate your own with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"

# Public URL of the site (Stripe return/onboarding URLs). Defaults to NEXTAUTH_URL.
APP_URL="http://localhost:3000"

# --- Payments (Stripe Connect) ------------------------------------------------
# Leave STRIPE_SECRET_KEY empty to run in demo mode with simulated payments.
# Use TEST keys (sk_test_ / pk_test_) until you go live. Never commit real keys.
# Recommended: a restricted key with write access to Checkout Sessions, PaymentIntents,
# Refunds, Transfers, Account Sessions and Connected accounts (v2 Accounts, Account Links).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Signing secret of your webhook endpoint (whsec_...). Locally: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=""

# GETTABLE's commission in basis points (1500 = 15%)
PLATFORM_COMMISSION_BPS="1500"

# Protects /api/jobs/payments (call it every ~15 min from a scheduler). At least 16 characters.
CRON_SECRET="change-me-to-a-long-random-string"
